# URL base de la API de Rust (Rocket). El backend escucha en el 8001.
#
# Debe empezar por NEXT_PUBLIC_ para que Next la inyecte en el bundle del
# navegador: las peticiones salen del cliente, no del servidor de Next.
#
# Si no se define, `src/lib/api.ts` cae en este mismo valor por defecto, así que
# en local la aplicación arranca sin configurar nada.
NEXT_PUBLIC_API_URL=http://localhost:8001
